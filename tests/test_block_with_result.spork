;; Test block-with-result pattern: while/for in if arms

;; Test 1: while in if then-branch with do block
(deftest while-in-if-then-branch-with-do-block
  (def result1
    (if true
      (do
        (def counter 0)
        (while (< counter 3)
          (set! counter (+ counter 1)))
        counter)
      99))

  (assert (= result1 3))
)


;; Test 2: while in if else-branch
(deftest while-in-if-else-branch
  (def result2
    (if false
      42
      (do
        (def counter 0)
        (while (< counter 5)
          (set! counter (+ counter 1)))
        counter)))

  (assert (= result2 5))
)


;; Test 3: while as only form in branch (should return nil)
(deftest while-as-only-form-in-branch-should-return-nil
  (def result3
    (if true
      (do
        (def counter 0)
        (while (< counter 2)
          (set! counter (+ counter 1))))
      "else"))

  (assert (= result3 nil))
)


;; Test 4: for in if branch
(deftest for-in-if-branch
  (def result4
    (if true
      (do
        (def items [])
        (for [x [1 2 3]]
          (set! items (+ items [x])))
        items)
      []))

  (assert (= result4 [1 2 3]))
)


;; Test 5: nested if with while
(deftest nested-if-with-while
  (def result5
    (if true
      (if true
        (do
          (def counter 0)
          (while (< counter 10)
            (set! counter (+ counter 1)))
          counter)
        0)
      -1))

  (assert (= result5 10))
)


;; Test 6: let with while in body
(deftest let-with-while-in-body
  (def result6
    (let [x 0]
      (while (< x 7)
        (set! x (+ x 1)))
      x))

  (assert (= result6 7))
)


;; Test 7: do with while
(deftest do-with-while
  (def result7
    (do
      (def counter 0)
      (while (< counter 4)
        (set! counter (+ counter 1)))
      counter))

  (assert (= result7 4))
)


;; Test 8: if with no else, while in then
(deftest if-with-no-else-while-in-then
  (def result8
    (if true
      (do
        (def counter 0)
        (while (< counter 6)
          (set! counter (+ counter 1))))))

  (assert (= result8 nil))
)


;; Test 9: Multiple statements before while
(deftest multiple-statements-before-while
  (def result9
    (if true
      (do
        (def temp 100)
        (def counter 0)
        (while (< counter 3)
          (set! counter (+ counter 1)))
        (+ counter temp))
      0))

  (assert (= result9 103))
)


;; Test 10: for loop with accumulator
(deftest for-loop-with-accumulator
  (def result10
    (let [sum 0]
      (for [x [10 20 30]]
        (set! sum (+ sum x)))
      sum))

  (assert (= result10 60))
)


;; Test 11: if returning expression value
(deftest if-returning-expression-value
  (def result11
    (if true
      (do
        (def x 5)
        (+ x 10))
      0))

  (assert (= result11 15))
)


;; Test 12: Mix of statements and expressions
(deftest mix-of-statements-and-expressions
  (def result12
    (do
      (def a 1)
      (def b 2)
      (+ a b)))

  (assert (= result12 3))

)
