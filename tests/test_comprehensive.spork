;; Test 1: Nested fn at top level
(deftest top-level-nested-fn
  (def result1
    (let [add-one (fn [x] (+ x 1))]
      (add-one 41)))
  (assert (= result1 42))
)


;; Test 2: Multiple nested fns
(deftest multiple-nested-fns
  (def result2
    (let [add (fn [x] (+ x 1))
          mul (fn [x] (* x 2))]
      (mul (add 10))))
  (assert (= result2 22))
)


;; Test 3: Nested fn with closure
(deftest nested-fn-with-closure
  (def result3
    (let [x 10]
      (let [add-x (fn [y] (+ x y))]
        (add-x 32))))
  (assert (= result3 42))
)


;; Test 4: set! with hyphenated names
(defn test-set-hyph []
  (let [my-var 0]
    (set! my-var 42)
    my-var))

(deftest set-with-hyphenated-name
  (assert (= (test-set-hyph) 42)))

;; Test 5: Complex nested structure
(deftest complex-nested-structure
  (def result5
    (let [make-adder (fn [n]
                       (fn [x] (+ x n)))]
      (let [add5 (make-adder 5)]
        (add5 37))))
  (assert (= result5 42))

)
