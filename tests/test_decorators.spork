;; Test decorators on functions

(ns test-decorators
  (:import [functools]))

;; Test 1: Simple decorator (staticmethod-like)

(defn my-decorator [f]
  (defn wrapper [& args]
    (let [result (apply f args)]
      result))
  wrapper)

(defn ^object ^my-decorator greet [name]
  (+ "Hello, " name "!"))

(deftest simple-decorator
  (assert (= (greet "World") "Hello, World!")))


;; Test 2: Multiple decorators

(def decorator-events (list))

(defn decorator-a [f]
  (defn wrapper [& args]
    (.append decorator-events :a-before)
    (let [result (apply f args)]
      (.append decorator-events :a-after)
      result))
  wrapper)

(defn decorator-b [f]
  (defn wrapper [& args]
    (.append decorator-events :b-before)
    (let [result (apply f args)]
      (.append decorator-events :b-after)
      result))
  wrapper)

(defn ^object ^decorator-a ^decorator-b say-hi []
  (.append decorator-events :body)
  "Hi!")

(deftest multiple-decorators
  (.clear decorator-events)
  (assert (= (say-hi) "Hi!"))
  (assert (= (vec decorator-events)
             [:a-before :b-before :body :b-after :a-after])))

;; Test 3: Decorator with arguments

(defn repeat-call [n]
  (fn [f]
    (fn [& args]
      (for [i (range n)]
        (apply f args)))))

(def ping-events (list))

(defn ^(repeat-call 3) ping []
  (.append ping-events :ping))

(deftest decorator-with-arguments
  (.clear ping-events)
  (ping)
  (assert (= (vec ping-events) [:ping :ping :ping])))

;; Test 4: functools.wraps decorator

(defn make-logged [f]
  (defn ^(functools.wraps f) logged [& args]
    (apply f args))
  logged)

(defn ^object ^make-logged add-nums [a b]
  (+ a b))

(deftest functools-wraps-preserves-name-and-result
  (assert (= add-nums.__name__ "add_nums"))
  (assert (= (add-nums 3 4) 7)))


;; Test 5: Decorator on multi-arity function

(defn logging-decorator [f]
  (defn wrapper [& args]
    (apply f args))
  wrapper)

(defn ^object ^logging-decorator multi-add
  ([x] x)
  ([x y] (+ x y))
  ([x y z] (+ x y z)))

(deftest decorator-wraps-every-multi-arity-branch
  (assert (= (multi-add 5) 5))
  (assert (= (multi-add 5 3) 8))
  (assert (= (multi-add 1 2 3) 6)))
