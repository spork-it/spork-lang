;; Test class definitions with defclass

(ns test-defclass
  (:import [dataclasses :refer [dataclass field]]))

;; Test 1: Basic class with __init__ and methods

(defclass Point
  (defn __init__ [self x y]
    (set! self.x x)
    (set! self.y y))

  (defn __repr__ [self]
    (+ "Point(" (str self.x) ", " (str self.y) ")"))

  (defn distance-from-origin [self]
    (** (+ (* self.x self.x) (* self.y self.y)) 0.5)))

(deftest basic-class-definition
  (def point (Point 3 4))
  (assert (= point.x 3))
  (assert (= point.y 4))
  (assert (= (.distance-from-origin point) 5.0))
  (assert (= (str point) "Point(3, 4)")))

;; Should be 5.0 (3-4-5 triangle)

;; Test 2: Inheritance

(defclass Point3D [Point]
  (defn __init__ [self x y z]
    (call (super) __init__ x y)
    (set! self.z z))

  (defn __repr__ [self]
    (+ "Point3D(" (str self.x) ", " (str self.y) ", " (str self.z) ")"))

  (defn distance-from-origin [self]
    (** (+ (* self.x self.x) (* self.y self.y) (* self.z self.z)) 0.5)))

(deftest inheritance
  (def point (Point3D 1 2 2))
  (assert (isinstance point Point))
  (assert (= point.z 2))
  (assert (= (.distance-from-origin point) 3.0))
  (assert (= (str point) "Point3D(1, 2, 2)")))

;; Should be 3.0

;; Test 3: Class with staticmethod and classmethod

(defclass MathUtils
  (def pi 3.14159)

  (defn ^staticmethod add [a b]
    (+ a b))

  (defn ^classmethod get-pi [cls]
    cls.pi)

  (defn ^staticmethod circle-area [radius]
    (* MathUtils.pi radius radius)))


;; Test 4: Class with properties

(defclass Temperature
  (defn __init__ [self celsius]
    (set! self._celsius celsius))

  (defn ^property celsius [self]
    self._celsius)

  (defn get-fahrenheit [self]
    (+ (* self._celsius 1.8) 32)))

(deftest properties
  (def temp (Temperature 100))
  (assert (= temp.celsius 100) "^property should create a readable property")
  (assert (not (callable temp.celsius)) "property access should not return a bound method")
)


;; Test 5: Decorated class (dataclass)

(defclass ^dataclass Config
  (field name str "default")
  (field debug bool false)
  (field max-retries int 3))

(deftest dataclass-decorator
  (def default-config (Config))
  (def custom-config (Config "custom" true 5))
  (assert (= default-config.name "default"))
  (assert (= default-config.debug false))
  (assert (= default-config.max-retries 3))
  (assert (= custom-config.name "custom"))
  (assert (= custom-config.debug true))
  (assert (= custom-config.max-retries 5)))


(defclass ^dataclass Person
  (field name str)
  (field age int)
  (field email str "unknown@example.com"))

(deftest dataclass-required-and-default-fields
  (def alice (Person "Alice" 30))
  (def bob (Person "Bob" 25 "bob@example.com"))
  (assert (= alice.email "unknown@example.com"))
  (assert (= bob.name "Bob"))
  (assert (= bob.age 25))
  (assert (= bob.email "bob@example.com")))


;; Test 6: Multiple inheritance

(defclass Printable
  (defn describe [self]
    (+ "I am " (.get-type self))))

(defclass Countable
  (def count 0)

  (defn ^classmethod increment [cls]
    (set! cls.count (+ cls.count 1))))

(defclass Counter [Printable Countable]
  (defn __init__ [self name]
    (set! self.name name)
    (.increment Counter))

  (defn get-type [self]
    (+ "Counter named '" self.name "'")))

(deftest multiple-inheritance
  (def initial-count Counter.count)
  (def first-counter (Counter "first"))
  (def second-counter (Counter "second"))
  (assert (= (.describe first-counter) "I am Counter named 'first'"))
  (assert (= (.describe second-counter) "I am Counter named 'second'"))
  (assert (= Counter.count (+ initial-count 2))))


;; Test 7: Class with class variables

(defclass Animal
  (def kingdom "Animalia")
  (def count 0)

  (defn __init__ [self name species]
    (set! self.name name)
    (set! self.species species)
    (set! Animal.count (+ Animal.count 1)))

  (defn __repr__ [self]
    (+ self.name " the " self.species)))

(deftest class-variables
  (def initial-count Animal.count)
  (def dog (Animal "Buddy" "Dog"))
  (def cat (Animal "Whiskers" "Cat"))
  (assert (= Animal.kingdom "Animalia"))
  (assert (= Animal.count (+ initial-count 2)))
  (assert (= (str dog) "Buddy the Dog"))
  (assert (= (str cat) "Whiskers the Cat")))


;; Test 8: Magic methods

(defclass Vector
  (defn __init__ [self items]
    (set! self.items (list items)))

  (defn __repr__ [self]
    (+ "Vector(" (str self.items) ")"))

  (defn __len__ [self]
    (len self.items))

  (defn __add__ [self other]
    (Vector (+ self.items other.items)))

  (defn __getitem__ [self index]
    (. self.items index)))

(deftest magic-methods-add-len-etc
  (def first-vector (Vector [1 2 3]))
  (def second-vector (Vector [4 5 6]))
  (def combined (+ first-vector second-vector))
  (assert (= (len combined) 6))
  (assert (= (. combined items 0) 1))
  (assert (= (. combined items 5) 6))
  (assert (= (str combined) "Vector([1, 2, 3, 4, 5, 6])")))
