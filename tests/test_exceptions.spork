; Comprehensive Exception Handling Demo
; Shows try-catch-finally and throw working together


; ============================================================================
; 1. Simple Error Handling Pattern
; ============================================================================


(defn safe-divide [x y]
  (try
    (/ x y)
    (catch ZeroDivisionError e
      nil)))



; ============================================================================
; 2. Custom Validation with throw
; ============================================================================


(defn validate-positive [n]
  (if (< n 0)
    (throw (ValueError "Number must be positive"))
    n))

(defn validate-range [n min max]
  (if (< n min)
    (throw (ValueError (+ "Number must be >= " (str min))))
    (if (> n max)
      (throw (ValueError (+ "Number must be <= " (str max))))
      n)))

(defn safe-sqrt [n]
  (try
    (validate-positive n)
    (** n 0.5)
    (catch ValueError e
      0)))



; ============================================================================
; 3. Resource Management with finally
; ============================================================================


(defn process-file [should-error]
  (try
    (if should-error
      (throw (RuntimeError "Processing failed!"))
      (do
        "success"))
    (catch RuntimeError e
      "failed")
    (finally
      nil)))

(deftest case-3-resource-management
  (def result3a (process-file false))

  (def result3b (process-file true))
  (assert (= result3a "success"))
  (assert (= result3b "failed"))
)


; ============================================================================
; 4. Multiple Exception Types
; ============================================================================


(defn parse-and-process [data type]
  (try
    (cond
      (= type "int") (int data)
      (= type "float") (float data)
      (= type "list") (. data 0)
      true (throw (ValueError "Unknown type")))
    (catch ValueError e
      nil)
    (catch TypeError e
      nil)
    (catch IndexError e
      nil)))



; ============================================================================
; 5. Exception Chaining and Re-throwing
; ============================================================================


(defn low-level-operation [x]
  (if (< x 0)
    (throw (RuntimeError "Low-level error"))
    (* x 2)))

(defn mid-level-operation [x]
  (try
    (low-level-operation x)
    (catch RuntimeError e
      (throw (RuntimeError "Mid-level re-throw")))))

(defn high-level-operation [x]
  (try
    (mid-level-operation x)
    (catch RuntimeError e
      "recovered")))



; ============================================================================
; 6. Try-Catch in Data Processing Pipeline
; ============================================================================


(defn safe-process [f x]
  (try
    (f x)
    (catch Exception e
      nil)))

(defn process-list [lst]
  (doseq [item lst]
    (let [result (safe-process (fn [x] (/ 100 x)) item)]
      (if result
        nil))))

(deftest case-6-data-processing-pipeline
  (assert (= (process-list [1 2 0 5 10]) nil))
)


; ============================================================================
; 7. Nested Try-Catch Blocks
; ============================================================================


(defn nested-operations [a b c]
  (try
    (let [result1 (try
                    (/ a b)
                    (catch ZeroDivisionError e
                      1))]
      (try
        (+ result1 (/ 10 c))
        (catch ZeroDivisionError e
          result1)))
    (catch Exception e
      -1)
    (finally
      nil)))



; ============================================================================
; 8. Exception Handling with State
; ============================================================================


(defn retry-operation [operation max-retries]
  (let [attempt 0]
    (while (< attempt max-retries)
      (let [result (try
                     (operation)
                     (catch RuntimeError e
                       nil))]
        (if result
          (do
            (return result))
          (set! attempt (+ attempt 1)))))
    nil))

; Won't work perfectly due to lambda closure limitations, but demonstrates the pattern


; ============================================================================
; 9. Exception-Safe Builder Pattern
; ============================================================================


(defn build-user [data]
  (try
    (let [name (. data :name)
          age (. data :age)
          email (. data :email)]
      ; Validate
      (if (not name)
        (throw (ValueError "Name is required"))
        (if (< age 0)
          (throw (ValueError "Age must be non-negative"))
          (if (not (in "@" email))
            (throw (ValueError "Invalid email"))
            {:name name :age age :email email :valid true}))))
    (catch ValueError e
      {:valid false :error (str e)})
    (catch KeyError e
      {:valid false :error (+ "Missing field: " (str e))})))





; ============================================================================
; Summary
; ============================================================================

(deftest simple-error-handling
  (assert (= (safe-divide 10 2) 5.0))
  (assert (= (safe-divide 10 0) nil)))

(deftest validation-with-throw
  (assert (= (safe-sqrt 16) 4.0))
  (assert (= (safe-sqrt -4) 0))
  (assert (= (validate-range 5 1 10) 5)))

(deftest multiple-exception-types
  (assert (= (parse-and-process "42" "int") 42))
  (assert (= (parse-and-process "bad" "int") nil))
  (assert (= (parse-and-process [] "list") nil)))

(deftest exception-chaining-and-recovery
  (assert (= (high-level-operation 5) 10))
  (assert (= (high-level-operation -1) "recovered")))

(deftest nested-try-catch-blocks
  (assert (= (nested-operations 10 2 5) 7.0))
  (assert (= (nested-operations 10 0 5) 3.0))
  (assert (= (nested-operations 10 2 0) 5.0)))

(deftest retry-exhaustion-returns-nil
  (defn fail [] (throw (RuntimeError "nope")))
  (assert (= (retry-operation fail 2) nil)))

(deftest exception-safe-builder
  (def valid (build-user {:name "Alice" :age 30 :email "alice@example.com"}))
  (def invalid (build-user {:name "Bob" :age 25 :email "invalid"}))
  (def missing (build-user {:name "Charlie" :age 40}))
  (assert (= (get valid :valid) true))
  (assert (= (get invalid :valid) false))
  (assert (= (get missing :valid) false)))
