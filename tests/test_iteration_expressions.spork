;; Eager iteration expression and effect-only iteration tests.
(ns test-iteration-expressions
  (:import [spork.pds :as pds]))

(deftest for-eagerly-returns-a-persistent-vector
  (def visited (list))
  (def values
    (for [x [1 2 3]]
      (visited.append x)
      (* x x)))
  (assert (isinstance values pds.Vector))
  (assert (= values [1 4 9]))
  ;; Construction is complete before the next form executes; there is no lazy
  ;; iterator whose effects depend on later consumption.
  (assert (= visited (list [1 2 3])))
  (assert (= values [1 4 9]))
  (assert (= values [1 4 9])))

(deftest for-retains-each-body-result-including-nil
  (def values
    (for [x (range 6)]
      (if (even? x) (* x 10) nil)))
  (assert (= values [0 nil 20 nil 40 nil])))

(deftest for-supports-destructuring-and-nesting
  (def pairs [[1 2] [3 4] [5 6]])
  (assert (= (for [[a b] pairs] (+ a b)) [3 7 11]))
  (def records
    [{:name "alpha" :score 8}
     {:name "beta" :score 13}])
  (assert (= (for [{:keys [name score]} records]
               [name score])
             [["alpha" 8] ["beta" 13]]))
  (assert (= (for [x [1 2]]
               (for [y [10 20]] (+ x y)))
             [[11 21] [12 22]])))

(deftest for-composes-in-expression-tail-positions
  (defn project [items]
    (for [item items] (* item 2)))
  (assert (= (project [1 2 3]) [2 4 6]))
  (def project-fn (fn [items] (for [item items] (* item 3))))
  (assert (= (project-fn [1 2 3]) [3 6 9]))
  (defn project-many
    ([items] (for [item items] (inc item)))
    ([scale items] (for [item items] (* scale item))))
  (assert (= (project-many [1 2]) [2 3]))
  (assert (= (project-many 10 [1 2]) [10 20]))
  (assert (= (do (for [x [2 3]] (* x x))) [4 9]))
  (assert (= (let [items [3 4]]
               (for [item items] (inc item)))
             [4 5]))
  (assert (= (if true
               (for [x [1 2]] (- 0 x))
               [])
             [-1 -2])))

(deftest for-body-can-update-an-enclosing-local
  (defn cumulative [items]
    (let [total 0]
      (def values
        (for [item items]
          (set! total (+ total item))
          total))
      [values total]))
  (assert (= (cumulative [1 2 3 4]) [[1 3 6 10] 10])))

(deftest sorted-for-eagerly-returns-a-sorted-vector
  (def values
    (sorted-for [x [3 1 4 1 5]] x :reverse true))
  (assert (isinstance values pds.SortedVector))
  (assert (= (vec values) [5 4 3 1 1]))

  (def records
    [{:name "alpha" :score 8}
     {:name "beta" :score 13}
     {:name "gamma" :score 5}])
  (def ranked
    (sorted-for [item records]
      {:name (:name item) :score (:score item)}
      :key :score
      :reverse true))
  (assert (isinstance ranked pds.SortedVector))
  (assert (= (for [item ranked] (:name item))
             ["beta" "alpha" "gamma"])))

(deftest doseq-is-explicitly-effect-only
  (def visited (list))
  (def result
    (doseq [x [1 2 3]]
      (visited.append x)
      (visited.append (* x 10))))
  (assert (= result nil))
  (assert (= visited (list [1 10 2 20 3 30]))))
