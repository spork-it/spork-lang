; Minimal test for lazy sequences


; Test map
(deftest test-map
  (def m (map inc [1 2 3]))
  (assert (= (vec m) [2 3 4]))
)


; Test filter
(deftest test-filter
  (def f (filter (fn [x] (> x 2)) [1 2 3 4 5]))
  (assert (= (vec f) [3 4 5]))
)


; Test take
(deftest test-take
  (def t (take 3 [1 2 3 4 5]))
  (assert (= (vec t) [1 2 3]))
)


; Test drop
(deftest test-drop
  (def d (drop 2 [1 2 3 4 5]))
  (assert (= (vec d) [3 4 5]))
)


; Test concat
(deftest test-concat
  (def c (concat [1 2] [3 4]))
  (assert (= (vec c) [1 2 3 4]))
)


; Test pipeline
(deftest test-pipeline
  (def result
    (vec (take 3 (filter (fn [x] (> x 2)) (map inc [1 2 3 4 5 6])))))
  (assert (= result [3 4 5]))
)
