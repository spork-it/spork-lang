; Test file for loop/recur Tail Call Optimization


; Basic countdown loop
(defn countdown [n]
  (loop [i n]
    (if (> i 0)
      (do
        (recur (- i 1)))
      nil)))

(deftest countdown-loop
  (assert (= (countdown 5) nil)))


; Sum of numbers from 1 to n using loop/recur
(defn sum-to [n]
  (loop [i 1 acc 0]
    (if (<= i n)
      (recur (+ i 1) (+ acc i))
      acc)))

(deftest loop-with-multiple-bindings
  (assert (= (sum-to 10) 55))
  (assert (= (sum-to 100) 5050)))

(deftest loop-as-expression
  (def factorial-10
    (loop [n 10 acc 1]
      (if (<= n 1)
        acc
        (recur (- n 1) (* acc n)))))
  (assert (= factorial-10 3628800)))


; Fibonacci using loop/recur - tests that recur properly uses temps
(defn fib [n]
  (loop [i n a 0 b 1]
    (if (= i 0)
      a
      (recur (- i 1) b (+ a b)))))



; This would cause RecursionError with normal recursion
(defn count-to [n]
  (loop [i 0]
    (if (< i n)
      (recur (+ i 1))
      i)))



(defn test-let-tail [n]
  (loop [i n]
    (if (> i 0)
      (let [next (- i 1)]
        (recur next))
      "done")))



(defn test-do-tail [n]
  (loop [i n acc []]
    (if (> i 0)
      (do
        (recur (- i 1) (+ acc [i])))
      acc)))



(defn classify-and-count [n]
  (loop [i 1 evens 0 odds 0]
    (if (> i n)
      {:evens evens :odds odds}
      (if (= (% i 2) 0)
        (recur (+ i 1) (+ evens 1) odds)
        (recur (+ i 1) evens (+ odds 1))))))



; Build a range by carrying a vector through recur
(defn range-values [start end]
  (loop [i start values []]
    (if (<= i end)
      (recur (+ i 1) (conj values i))
      values)))

(deftest loop-can-carry-a-collection
  (assert (= (range-values 1 3) [1 2 3])))


(defn gcd [a b]
  (loop [x a y b]
    (if (= y 0)
      x
      (recur y (% x y)))))



(defn fizzbuzz-count [n]
  (loop [i 1 fizzes 0 buzzes 0 fizzbuzzes 0]
    (cond
      (> i n) {:fizzes fizzes :buzzes buzzes :fizzbuzzes fizzbuzzes}
      (= (% i 15) 0) (recur (+ i 1) fizzes buzzes (+ fizzbuzzes 1))
      (= (% i 3) 0) (recur (+ i 1) (+ fizzes 1) buzzes fizzbuzzes)
      (= (% i 5) 0) (recur (+ i 1) fizzes (+ buzzes 1) fizzbuzzes)
      :else (recur (+ i 1) fizzes buzzes fizzbuzzes))))



; Nested loops - inner loop uses outer loop's variable
(defn sum-of-triangle-numbers [n]
  "Calculate sum of first n triangle numbers using nested loops"
  (loop [outer n result 0]
    (if (= outer 0)
      result
      (let [triangle (loop [inner outer acc 0]
                       (if (= inner 0)
                         acc
                         (recur (- inner 1) (+ acc inner))))]
        (recur (- outer 1) (+ result triangle))))))


; Triple nested loops
(defn nested-3-deep [n]
  (loop [i n total 0]
    (if (= i 0)
      total
      (let [mid-sum (loop [j i mid 0]
                      (if (= j 0)
                        mid
                        (let [inner-sum (loop [k j inner 0]
                                          (if (= k 0)
                                            inner
                                            (recur (- k 1) (+ inner 1))))]
                          (recur (- j 1) (+ mid inner-sum)))))]
        (recur (- i 1) (+ total mid-sum))))))



; This would cause RecursionError with normal recursion (Python limit ~1000)
; but works fine with loop/recur TCO
(defn deep-sum [n]
  "Sum from 1 to n using loop/recur - works even for n > recursion limit"
  (loop [i 1 acc 0]
    (if (> i n)
      acc
      (recur (+ i 1) (+ acc i)))))

; Test with 100,000 iterations - way beyond Python's recursion limit

; For comparison, here's what would fail with normal recursion:
; (defn bad-sum [n acc]
;   (if (= n 0) acc (bad-sum (- n 1) (+ acc n))))
; (bad-sum 100000 0)  ; RecursionError!
(deftest recur-swaps-binding-values-simultaneously
  (assert (= (fib 0) 0))
  (assert (= (fib 1) 1))
  (assert (= (fib 10) 55)))

(deftest recur-does-not-consume-python-stack
  (assert (= (count-to 100000) 100000)))

(deftest recur-is-valid-in-let-tail-position
  (assert (= (test-let-tail 1000) "done")))

(deftest recur-is-valid-in-do-tail-position
  (assert (= (test-do-tail 3) [3 2 1])))

(deftest recur-supports-multiple-accumulators
  (def counts (classify-and-count 10))
  (assert (= (get counts :evens) 5))
  (assert (= (get counts :odds) 5)))

(deftest euclidean-algorithm-with-recur
  (assert (= (gcd 54 24) 6)))

(deftest conditional-recur-updates-selected-accumulators
  (def counts (fizzbuzz-count 30))
  (assert (= (get counts :fizzes) 8))
  (assert (= (get counts :buzzes) 4))
  (assert (= (get counts :fizzbuzzes) 2)))

(deftest nested-loops-can-read-outer-bindings
  (assert (= (sum-of-triangle-numbers 3) 10)))

(deftest deeply-nested-loops-return-values
  (assert (= (nested-3-deep 3) 10)))

(deftest large-loop-remains-stack-safe
  (assert (= (deep-sum 100000) 5000050000)))
