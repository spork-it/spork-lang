; Test macro system
(ns tests.test-macros)

(defmacro when [test body]
  `(if ~test ~body nil))

(defmacro unless [test body]
  `(if ~test nil ~body))

(deftest test-macro-system
  (def a (when true 100))
  (def b (unless false 200))

  (assert (= a 100))
  (assert (= b 200))
)


; Test quasiquote
(deftest test-quasiquote
  (def x 10)
  (def y 20)
  (def expr `(+ ~x ~y))
  (assert (= (str (nth expr 0)) "+"))
  (assert (= (nth expr 1) 10))
  (assert (= (nth expr 2) 20))
)


; Test threading macro
(defmacro -> [x form]
  `(~(. form 0) ~x ~(. form 1)))

(deftest test-threading-macro
  (def result (-> 5 (+ 3)))
  (assert (= result 8))
)
