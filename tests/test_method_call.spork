;; Canonical dotted calls and backward-compatible leading-dot method calls


;; Test 1: Basic method call - use Python list for mutation
(def test-append
  (fn []
    (let [lst (list [1 2 3])]
      (lst.append 4)
      lst)))


;; Test 2: Method call with string
(def test-string-methods
  (fn []
    (let [text "hello world"]
      (text.upper))))


;; Test 3: Method call in let binding
(def test-method-in-binding
  (fn []
    (let [text "one,two,three"
          parts (text.split ",")]
      parts)))


;; Test 4: Chained-ish method calls
(def test-multiple-methods
  (fn []
    (let [text "  hello  "
          trimmed (text.strip)
          upper (trimmed.upper)]
      upper)))


;; Test 5: Method with multiple args
(def test-replace
  (fn []
    (let [text "hello world"]
      (text.replace "world" "python"))))


;; Test 6: Method call in complex expression - use Python list for .count
(def test-method-in-expr
  (fn []
    (+ 1 2 (.count (list [1 2 3 2 1]) 2))))

(deftest dotted-method-call-can-mutate-a-python-list
  (assert (= (test-append) (list [1 2 3 4]))))

(deftest dotted-string-method-call
  (assert (= (test-string-methods) "HELLO WORLD")))

(deftest method-call-can-initialize-a-binding
  (assert (= (test-method-in-binding) (list ["one" "two" "three"]))))

(deftest method-calls-can-be-chained-through-bindings
  (assert (= (test-multiple-methods) "HELLO")))

(deftest method-call-supports-multiple-arguments
  (assert (= (test-replace) "hello python")))

(deftest method-call-can-appear-in-an-expression
  (assert (= (test-method-in-expr) 5)))

(deftest dotted-leading-dot-and-call-spellings-agree
  (let [text "compatibility"
        n 8]
    (assert (= (text.upper) (.upper text)))
    (assert (= (n.bit-length) (.bit-length n)))
    (assert (= (n.bit-length) (call n bit-length)))))
