; Test multi-arity functions


; Basic multi-arity defn
(defn greet
  ([] "Hello, World!")
  ([name] (+ "Hello, " name "!"))
  ([greeting name] (+ greeting ", " name "!")))


; Multi-arity with varargs
(defn add
  ([x] x)
  ([x y] (+ x y))
  ([x y & more]
    (let [total (+ x y)]
      (for [n more]
        (set! total (+ total n)))
      total)))

(deftest named-multi-arity-functions
  (assert (= (greet) "Hello, World!"))
  (assert (= (greet "Spork") "Hello, Spork!"))
  (assert (= (greet "Welcome" "Spork") "Welcome, Spork!"))
  (assert (= (add 5) 5))
  (assert (= (add 3 4) 7))
  (assert (= (add 1 2 3) 6))
  (assert (= (add 1 2 3 4 5) 15)))

(deftest anonymous-multi-arity-functions
  (let [mul (fn
              ([x] x)
              ([x y] (* x y))
              ([x y z] (* x y z)))]
    (assert (= (mul 5) 5))
    (assert (= (mul 3 4) 12))
    (assert (= (mul 2 3 4) 24))))


; Multi-arity with different return types
(defn describe
  ([] "nothing")
  ([x] (+ "one thing: " (str x)))
  ([x y] (+ "two things: " (str x) " and " (str y))))


; Multi-arity with let bodies
(defn compute
  ([x]
    (let [doubled (* x 2)]
      doubled))
  ([x y]
    (let [sum (+ x y)
          product (* x y)]
      (+ sum product))))


; Multi-arity with conditionals
(defn safe-div
  ([x] x)
  ([x y]
    (if (= y 0)
      nil
      (/ x y))))


; Multi-arity using other arities (recursive pattern)
(defn factorial-helper
  ([n] (factorial-helper n 1))
  ([n acc]
    (if (<= n 1)
      acc
      (factorial-helper (- n 1) (* n acc)))))

(deftest multi-arity-functions-can-delegate-to-another-arity
  (assert (= (factorial-helper 5) 120))
  (assert (= (factorial-helper 10) 3628800)))

(deftest multi-arity-functions-are-first-class
  (let [sum-op (fn ([] 0) ([x] x) ([x y] (+ x y)))
        product-op (fn ([] 1) ([x] x) ([x y] (* x y)))]
    (assert (= (sum-op) 0))
    (assert (= (sum-op 5) 5))
    (assert (= (sum-op 3 4) 7))
    (assert (= (product-op) 1))
    (assert (= (product-op 5) 5))
    (assert (= (product-op 3 4) 12))))


; Multi-arity with destructuring
(defn point-info
  ([[x y]] (+ "Point at " (str x) ", " (str y)))
  ([[x1 y1] [x2 y2]]
    (let [dx (- x2 x1)
          dy (- y2 y1)]
      (+ "Distance: " (str (** (+ (* dx dx) (* dy dy)) 0.5))))))


; Empty body (returns nil)
(defn maybe-do
  ([] nil)
  ([x] x))


; Test error case - wrong number of args
(deftest multi-arity-bodies-support-regular-language-forms
  (assert (= (describe) "nothing"))
  (assert (= (describe 1) "one thing: 1"))
  (assert (= (compute 5) 10))
  (assert (= (compute 2 3) 11))
  (assert (= (safe-div 10) 10))
  (assert (= (safe-div 10 0) nil))
  (assert (= (safe-div 10 2) 5.0))
  (assert (= (point-info [3 4]) "Point at 3, 4"))
  (assert (= (maybe-do) nil))
  (assert (= (maybe-do 42) 42)))

(deftest unsupported-arity-raises-type-error
  (def caught
    (try
      (greet "a" "b" "c")
      false
      (catch TypeError _error true)))
  (assert caught))
