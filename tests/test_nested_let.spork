;; Tests for nested let expressions and closures.

(defn nested-read []
  (let [x 10]
    (let [y 20]
      (+ x y))))

(defn nested-sequential []
  (let [a 5]
    (let [b (* a 2)
          c (+ b a)]
      c)))

(defn triple-nested []
  (let [x 1]
    (let [y 2]
      (let [z 3]
        (+ x y z)))))

(defn nested-closure []
  (let [multiplier 3]
    (let [adder 10
          function (fn [x] (+ (* x multiplier) adder))]
      (function 5))))

(defn outer-mutation []
  (let [x 0]
    (set! x 5)
    (let [y (* x 2)]
      (+ x y))))

(defn inner-mutation []
  (let [x 10]
    (let [y 0]
      (set! y 20)
      (+ x y))))

(defn sibling-lets []
  (let [a 1
        b (let [x 10 y 20] (+ x y))
        c (let [m 5 n 3] (* m n))]
    (+ a b c)))

(defn let-in-binding []
  (let [outer 100
        inner (let [x 10 y 20] (+ x y outer))]
    inner))

(deftest inner-let-can-read-outer-binding
  (assert (= (nested-read) 30)))

(deftest nested-bindings-are-sequential
  (assert (= (nested-sequential) 15)))

(deftest multiple-levels-of-nesting
  (assert (= (triple-nested) 6)))

(deftest nested-function-closes-over-bindings
  (assert (= (nested-closure) 25)))

(deftest inner-let-observes-outer-mutation
  (assert (= (outer-mutation) 15)))

(deftest inner-binding-can-be-mutated
  (assert (= (inner-mutation) 30)))

(deftest sibling-let-expressions-return-values
  (assert (= (sibling-lets) 46)))

(deftest let-can-be-used-in-a-binding-value
  (assert (= (let-in-binding) 130)))
