;; Test separate Spork namespace and Python module loading

(ns test.ns
  (:require [std.json :as json])
  (:import [math :as m]
           [statistics :as stats]))

;; Test Python module import
(deftest test-python-module-import
  (assert (= (m.sqrt 16) (.sqrt m 16)) "Qualified and leading-dot module calls should agree")
  (assert (= (stats.mean [1 2 3]) 2) "Python modules load through :import")
)


;; Define something in this namespace
(defn local-fn [x]
  "A function defined in the test namespace"
  (* x 10))


;; Test that std.json works with dot notation
(deftest test-that-std-json-works-with-dot-notation
  (def json-str (json.dumps {:name "test" :value 42}))
  (assert (in "name" json-str) "json.dumps should serialize map")
)


;; Test parsing
(deftest test-parsing
  (def parsed (json.loads "{\"x\": 1, \"y\": 2}"))
  (assert (= (get parsed "x") 1) "json.loads should parse JSON")

)
