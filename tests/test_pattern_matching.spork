; Test file for pattern matching
; Tests the match form and pattern syntax


;; === Literal patterns ===

(deftest literal-patterns

  ; nil pattern
  (let [result (match nil
                 nil :nothing
                 _   :something)]
    (assert (= result :nothing)))

  ; boolean patterns
  (let [result (match true
                 true  :yes
                 false :no)]
    (assert (= result :yes)))

  (let [result (match false
                 true  :yes
                 false :no)]
    (assert (= result :no)))

  ; number patterns
  (let [result (match 42
                 0  :zero
                 42 :answer
                 _  :other)]
    (assert (= result :answer)))

  ; string patterns
  (let [result (match "hello"
                 "goodbye" :bye
                 "hello"   :hi
                 _         :other)]
    (assert (= result :hi)))

  ; keyword patterns
  (let [result (match :ok
                 :error :bad
                 :ok    :good
                 _      :other)]
    (assert (= result :good)))
)


;; === Wildcard patterns ===

(deftest wildcard-patterns

  (let [result (match 999
                 _ :anything)]
    (assert (= result :anything)))
)


;; === Variable binding patterns ===

(deftest variable-binding-patterns

  (let [result (match 42
                 x x)]
    (assert (= result 42)))

  (let [result (match "test"
                 0 :zero
                 s (+ "got: " s))]
    (assert (= result "got: test")))
)


;; === Vector patterns ===

(deftest vector-patterns

  ; empty vector
  (let [result (match []
                 [] :empty
                 _  :not-empty)]
    (assert (= result :empty)))

  ; fixed-length vector
  (let [result (match [1 2 3]
                 [a b c] (+ a b c)
                 _       :other)]
    (assert (= result 6)))

  ; length mismatch (should fail to match)
  (let [result (match [1 2]
                 [a b c] :three
                 [a b]   :two
                 _       :other)]
    (assert (= result :two)))

  ; vector with rest
  (let [result (match [1 2 3 4 5]
                 [a b & rest] [a b rest]
                 _            :other)]
    (assert (= (nth result 0) 1))
    (assert (= (nth result 1) 2)))

  ; nested vector
  (let [result (match [[1 2] [3 4]]
                 [[a b] [c d]] (+ a b c d)
                 _             :other)]
    (assert (= result 10)))
)


;; === Map patterns ===

(deftest map-patterns

  ; :keys syntax
  (let [result (match {:name "Alice" :age 30}
                 {:keys [name age]} (+ name " is " (str age))
                 _                  :other)]
    (assert (= result "Alice is 30")))

  ; Clojure-style {binding :key}
  (let [result (match {:x 10 :y 20}
                 {a :x b :y} (+ a b)
                 _           :other)]
    (assert (= result 30)))

  ; Missing key should fail
  (let [result (match {:x 10}
                 {:keys [x y]} :has-both
                 {:keys [x]}   :has-x
                 _             :other)]
    (assert (= result :has-x)))
)


;; === Type patterns ===

(deftest type-patterns

  ; int type
  (let [result (match 42
                 (^int n)  [:int n]
                 (^str s)  [:str s]
                 _         :other)]
    (assert (= (nth result 0) :int))
    (assert (= (nth result 1) 42)))

  ; str type
  (let [result (match "hello"
                 (^int n)  [:int n]
                 (^str s)  [:str s]
                 _         :other)]
    (assert (= (nth result 0) :str))
    (assert (= (nth result 1) "hello")))

  ; list type
  (let [result (match [1 2 3]
                 (^list lst)   [:list lst]
                 (^Vector pv) [:Vector pv]
                 _             :other)]
    (assert (= (nth result 0) :Vector)))

  ; type pattern with nested vector pattern
  (let [result (match [10 20]
                 (^Vector [a b]) (+ a b)
                 _                :other)]
    (assert (= result 30)))
)


;; === Guards (:when) ===

(deftest guards-when

  ; simple guard
  (let [result (match 10
                 (n :when (> n 5)) :big
                 (n :when (<= n 5)) :small
                 _                  :other)]
    (assert (= result :big)))

  (let [result (match 3
                 (n :when (> n 5)) :big
                 (n :when (<= n 5)) :small
                 _                  :other)]
    (assert (= result :small)))

  ; type pattern with guard
  (let [result (match 42
                 ((^int n) :when (>= n 0)) :nonnegative
                 (^int n)                  :negative
                 _                         :not-int)]
    (assert (= result :nonnegative)))

  (let [result (match -5
                 ((^int n) :when (>= n 0)) :nonnegative
                 (^int n)                  :negative
                 _                         :not-int)]
    (assert (= result :negative)))

  ; guard with destructuring
  (let [result (match [3 4]
                 ([a b] :when (> (+ a b) 10)) :big-sum
                 ([a b] :when (<= (+ a b) 10)) :small-sum
                 _                             :other)]
    (assert (= result :small-sum)))
)


;; === Complex patterns ===


; Multiple cases with fallthrough
(defn classify [x]
  (match x
    nil           :nil
    true          :true
    false         :false
    0             :zero
    ""            :empty-string
    []            :empty-vector
    (^int n)      :int
    (^str s)      :string
    (^Vector v)  :vector
    (^dict d)     :dict
    _             :unknown))

(deftest complex-patterns
  (assert (= (classify nil) :nil))

  (assert (= (classify true) :true))

  (assert (= (classify 42) :int))

  (assert (= (classify "hi") :string))

  (assert (= (classify [1 2]) :vector))

  ; Nested complex pattern
  (let [data {:type :point :coords [3 4]}
        result (match data
                 {:keys [type coords]}
                   (match [type coords]
                     [:point [x y]] (+ (* x x) (* y y))
                     _              :unknown)
                 _                    :invalid)]
    (assert (= result 25)))
)


;; === Error handling ===

(deftest error-handling

  ; MatchError when no pattern matches
  (try
    (match 42
      "not a number" :string
      nil            :nil)
    (assert false)
    (catch MatchError e
      nil))
)


;; === Real-world examples ===


; Option/Maybe pattern
(defn safe-div [a b]
  (if (= b 0)
    nil
    (/ a b)))

(defn handle-result [result]
  (match result
    nil :division-by-zero
    n   [:ok n]))

(deftest real-world-examples
  (assert (= (nth (handle-result (safe-div 10 2)) 1) 5.0))

  (assert (= (handle-result (safe-div 10 0)) :division-by-zero))
)


; Tree traversal
(defn sum-tree [tree]
  (match tree
    nil         0
    (^int n)    n
    [left right] (+ (sum-tree left) (sum-tree right))
    _           0))

(deftest real-world-examples-2
  (let [tree [[1 2] [3 [4 5]]]]
    (assert (= (sum-tree tree) 15)))
)


; Command dispatch
(defn handle-command [cmd]
  (match cmd
    {:keys [action target]}
      (match action
        :create (+ "Creating " target)
        :delete (+ "Deleting " target)
        :update (+ "Updating " target)
        _       "Unknown action")
    _
      "Invalid command"))

(deftest real-world-examples-3
  (assert (= (handle-command {:action :create :target "file"}) "Creating file"))

)
