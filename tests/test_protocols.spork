;; Test protocols
(ns tests.test_protocols)

;; === Basic Protocol Definition ===

(defprotocol IGreet
  "A protocol for things that can greet"
  (greet [x])
  (farewell [x]))

;; === Extend for a Python builtin ===

(extend-type str
  IGreet
  (greet [s] (+ "Hello, " s "!"))
  (farewell [s] (+ "Goodbye, " s "!")))

;; Test basic extension

;; === Define a Spork class and extend ===

(defclass Person
  (defn __init__ [self name]
    (set! self.name name)))

(extend-type Person
  IGreet
  (greet [p] (+ "Hello, " p.name "!"))
  (farewell [p] (+ "See you later, " p.name "!")))

(def alice (Person "Alice"))

;; === Test isinstance with protocol ABC ===


;; === Numeric protocol ===

(defprotocol INumeric
  "Protocol for numeric operations"
  (add-one [x])
  (double-val [x]))

(extend-type int
  INumeric
  (add-one [n] (+ n 1))
  (double-val [n] (* n 2)))

(extend-type float
  INumeric
  (add-one [n] (+ n 1.0))
  (double-val [n] (* n 2.0)))


;; === Structural protocol ===

(defprotocol ^structural ICloseable
  "Protocol for things that can be closed (with duck-typing fallback)"
  (close [x]))

;; Define a class with a close method but don't extend the protocol
(defclass Resource
  (defn __init__ [self name]
    (set! self.name name)
    (set! self.closed false))
  (defn close [self]
    (set! self.closed true)
    nil))

(deftest structural-protocol
  (def resource (Resource "my-resource"))
  (assert (= resource.closed false))
  (close resource)
  (assert (= resource.closed true)))


;; === extend-protocol (sugar for multiple extend-type) ===

(defprotocol IStringify
  "Protocol for converting to string representation"
  (stringify [x]))

(extend-protocol IStringify
  int
  (stringify [n] (+ "Int<" (str n) ">"))

  float
  (stringify [n] (+ "Float<" (str n) ">"))

  str
  (stringify [s] (+ "Str<" s ">")))


;; === Protocol with multiple args ===

(defprotocol ICollection
  "Protocol for collection-like things"
  (add-item [coll item])
  (get-item [coll idx]))

(extend-type list
  ICollection
  (add-item [coll item]
    (let [result (list coll)]  ; copy the list
      (.append result item)
      result))
  (get-item [coll idx] (nth coll idx)))

(deftest protocol-with-multiple-args
  (def original (list [1 2 3]))
  (def updated (add-item original 4))
  (assert (= updated (list [1 2 3 4])))
  (assert (= original (list [1 2 3])))
  (assert (= (get-item original 0) 1)))


;; === Pattern matching on protocols ===

(defn describe [x]
  (match x
    (^IGreet g) (+ "Greeter: " (greet g))
    (^INumeric n) (+ "Number: " (str (double-val n)))
    _ "Unknown"))

(deftest protocol-extension-for-python-builtins
  (assert (= (greet "World") "Hello, World!"))
  (assert (= (farewell "World") "Goodbye, World!")))

(deftest protocol-extension-for-spork-classes
  (assert (= (greet alice) "Hello, Alice!"))
  (assert (= (farewell alice) "See you later, Alice!")))

(deftest protocol-membership-reflects-extensions
  (assert (isinstance "Bob" IGreet))
  (assert (isinstance alice IGreet))
  (assert (not (isinstance 42 IGreet))))

(deftest protocol-can-extend-multiple-numeric-types
  (assert (= (add-one 5) 6))
  (assert (= (double-val 5) 10))
  (assert (= (add-one 3.5) 4.5))
  (assert (= (double-val 3.5) 7.0)))

(deftest extend-protocol-registers-every-type
  (assert (= (stringify 42) "Int<42>"))
  (assert (= (stringify 3.14) "Float<3.14>"))
  (assert (= (stringify "hello") "Str<hello>")))

(deftest protocols-participate-in-pattern-matching
  (assert (= (describe "Test") "Greeter: Hello, Test!"))
  (assert (= (describe alice) "Greeter: Hello, Alice!"))
  (assert (= (describe 10) "Number: 20")))
