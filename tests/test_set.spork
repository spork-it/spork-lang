(ns test-set
  (:import [operator]
           [builtins]
           [spork.pds :as pds]))

(deftest empty-set
  (def value (hash-set))
  (assert (= (count value) 0))
  (assert (= (seq value) nil)))

(deftest set-creation-and-membership
  (def value (hash-set [1 2 3]))
  (assert (= value #{1 2 3}))
  (assert (contains? value 1))
  (assert (not (contains? value 4))))

(deftest conj-is-persistent-and-idempotent
  (def original #{1 2 3})
  (def added (conj original 4))
  (assert (= added #{1 2 3 4}))
  (assert (= original #{1 2 3}))
  (assert (is original (conj original 2))))

(deftest disj-is-persistent-and-idempotent
  (def original #{1 2 3})
  (assert (= (disj original 2) #{1 3}))
  (assert (= original #{1 2 3}))
  (assert (is original (disj original 99))))

(deftest set-is-iterable-and-seqable
  (def visited (hash-set))
  (for [item #{1 2 3}]
    (set! visited (conj visited item)))
  (assert (= visited #{1 2 3}))
  (assert (= (hash-set (seq visited)) visited)))

(deftest set-literal
  (def value #{:a :b :c})
  (assert (= (count value) 3))
  (assert (contains? value :a))
  (assert (not (contains? value :z))))

(deftest set-algebra
  (def left #{1 2 3})
  (def right #{3 4 5})
  (assert (= (bit-or left right) #{1 2 3 4 5}))
  (assert (= (bit-and left right) #{3}))
  (assert (= (operator.sub left right) #{1 2}))
  (assert (= (bit-xor left right) #{1 2 4 5})))

(deftest set-equality-and-hashing-ignore-order
  (def left #{1 2 3})
  (def reordered #{3 2 1})
  (assert (= left reordered))
  (assert (= (hash left) (hash reordered)))
  (assert (!= left #{3 4 5})))

(deftest subset-and-superset-comparisons
  (def whole #{1 2 3})
  (def part #{1 2})
  (assert (< part whole))
  (assert (<= part whole))
  (assert (> whole part))
  (assert (>= whole part))
  (assert (<= whole whole))
  (assert (not (< whole whole))))

(deftest sets-support-mixed-value-types
  (def value #{1 "hello" :keyword 3.14})
  (assert (contains? value 1))
  (assert (contains? value "hello"))
  (assert (contains? value :keyword)))

(deftest transient-set-operations
  (def original #{1 2 3})
  (let [mutable (.transient original)
        _ (.conj_mut mutable 4)
        _ (.conj_mut mutable 5)
        _ (.disj_mut mutable 2)
        result (.persistent mutable)]
    (assert (= result #{1 3 4 5}))
    (assert (= original #{1 2 3}))))

(deftest transient-set-is-invalid-after-persistent
  (def mutable (.transient #{1 2 3}))
  (.persistent mutable)
  (def caught
    (try
      (.conj_mut mutable 20)
      false
      (catch RuntimeError _error true)))
  (assert caught))

(deftest set-interoperates-with-python-set
  (def python-set (builtins.set [4 5 6]))
  (assert (= (bit-or #{1 2 3} python-set) #{1 2 3 4 5 6})))

(deftest large-set
  (def value (hash-set (range 100)))
  (assert (= (count value) 100))
  (assert (contains? value 50))
  (assert (not (contains? value 100))))

(deftest empty-set-constant
  (assert (= (count pds.EMPTY_SET) 0))
  (assert (= (hash-set) pds.EMPTY_SET)))

(deftest into-and-empty-preserve-set-type
  (assert (= (into #{} [1 2 3 2 1]) #{1 2 3}))
  (assert (= (into #{1 2} [3 4]) #{1 2 3 4}))
  (assert (= (empty #{1 2 3}) #{})))
