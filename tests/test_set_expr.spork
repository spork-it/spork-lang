;; Tests for set! as an expression with variable and attribute targets.

(ns test-set-expr
  (:import [types]))

(deftest variable-assignment-returns-the-assigned-value
  (def value 0)
  (def result (set! value 42))
  (assert (= value 42))
  (assert (= result 42)))

(deftest set-expression-can-initialize-a-let-binding
  (def value 0)
  (def result (let [assigned (set! value 100)] (+ assigned 50)))
  ;; The expression runs in the let's generated scope; the outer binding is unchanged.
  (assert (= value 0))
  (assert (= result 150)))

(deftest attribute-assignment-returns-the-assigned-value
  (def object (types.SimpleNamespace))
  (def result (set! (. object x) 99))
  (assert (= object.x 99))
  (assert (= result 99)))

(deftest set-expression-can-be-nested-in-arithmetic
  (def object (types.SimpleNamespace))
  (def result (+ (set! (. object y) 88) 12))
  (assert (= object.y 88))
  (assert (= result 100)))

(deftest set-expression-can-be-used-in-a-conditional
  (def object (types.SimpleNamespace))
  (def result
    (if true
      (set! (. object x) 777)
      0))
  (assert (= object.x 777))
  ;; A statement-only conditional branch returns nil after performing the assignment.
  (assert (= result nil)))

(deftest set-expression-can-be-multiplied
  (def object (types.SimpleNamespace))
  (def result (* 2 (set! (. object y) 50)))
  (assert (= object.y 50))
  (assert (= result 100)))
