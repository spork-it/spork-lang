; Exercises source-mapped functions through successful and exceptional paths.

(defn divide [a b]
  (/ a b))

(defn nested-divide-by-zero []
  (let [x 10]
    (let [y 0]
      (divide x y))))

(defn checked-divide [n]
  (if (< n 0)
    (throw (ValueError "negative number"))
    (divide 100 n)))

(deftest source-mapped-function-returns-a-value
  (assert (= (divide 10 2) 5)))

(deftest source-mapped-let-bindings-return-a-value
  (let [a 6 b 2]
    (assert (= (divide a b) 3))))

(deftest source-mapped-nested-call-raises-at-the-original-form
  (def caught
    (try
      (nested-divide-by-zero)
      false
      (catch ZeroDivisionError _error true)))
  (assert caught))

(deftest source-mapped-conditional-success-path
  (assert (= (checked-divide 5) 20)))

(deftest source-mapped-conditional-zero-path
  (def caught
    (try
      (checked-divide 0)
      false
      (catch ZeroDivisionError _error true)))
  (assert caught))

(deftest source-mapped-throw-path
  (def message
    (try
      (checked-divide -1)
      (catch ValueError error (str error))))
  (assert (= message "negative number")))
