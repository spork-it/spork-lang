; Test file for Stage 0 cleanup: do, booleans, and nil

(deftest case-1

  (def my-true true)
  (def my-false false)
  (def my-nil nil)

  (assert (= my-true true))
  (assert (= my-false false))
  (assert (= my-nil nil))
  (assert (= (if true "yes" "no") "yes"))
  (assert (= (if false "yes" "no") "no"))
  (assert (= (if nil "yes" "no") "no"))
)


; Test in if expressions


; do at statement level should execute multiple statements in sequence
(defn test-stmt-do [events]
  (do
    (.append events :first)
    (.append events :second)
    (.append events :third)))

(deftest test-in-if-expressions
  (def events (list))
  (test-stmt-do events)
  (assert (= (vec events) [:first :second :third]))

  ; do at expression level should return the last value
  (def result1 (do
                 42))

  (assert (= result1 42))

  ; do in function call

  ; do with different types
  (def result2 (do
                 1
                 2
                 3
                 "hello"
                 [1 2 3]))

  (assert (= result2 [1 2 3]))

  ; do returning boolean
  (def result3 (do
                 true))

  (assert (= result3 true))

  ; do returning nil
  (def result4 (do
                 nil))

  (assert (= result4 nil))


  ; do in if branches (expression context)
  (def x (if true
           (do
             "true-result")
           (do
             "false-result")))

  (assert (= x "true-result"))


  (def nested (do
                (do
                  "inner-value")
                "outer-value"))

  (assert (= nested "outer-value"))

)


; Empty do at statement level
(defn test-empty-do []
  (do))

(deftest test-in-if-expressions-2
  (assert (= (test-empty-do) nil))

  ; Single element do
  (def single (do 99))
  (assert (= single 99))

)
