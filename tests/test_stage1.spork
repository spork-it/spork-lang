; Test file for Stage 1: Minimal "real language core"
; Tests: let, fn, while, for, return, set!

(ns test-stage1
  (:import [builtins :refer [range]]
           [types :refer [SimpleNamespace]]))


(defn test-let-stmt []
  (let [x 10
        y 20]
    (+ x y)))

(deftest let-in-statement-context
  (assert (= (test-let-stmt) 30)))


; Sequential bindings
(defn test-sequential-bindings []
  (let [a 5
        b (+ a 3)
        c (* b 2)]
    c))

(deftest case-2
  (assert (= (test-sequential-bindings) 16))


  (def result1 (let [x 100
                     y 200]
                 (+ x y)))


  ; Nested let
  (def result2 (let [a 1]
                 (let [b 2]
                   (+ a b))))


  ; Let with sequential binding in expression context
  (def result3 (let [x 10
                     y (+ x 5)
                     z (* y 2)]
                 z))

  (assert (= result1 300))
  (assert (= result2 3))
  (assert (= result3 30))
)


; Simple lambda
(def add (fn [x y] (+ x y)))

; Lambda with no args
(def get-42 (fn [] 42))

; Lambda with multiple body forms
(def verbose-add (fn [x y]
                   (+ x y)))


; Higher-order function
(def apply-twice (fn [f x]
                   (f (f x))))

(def inc (fn [n] (+ n 1)))

; Closure
(def make-adder (fn [n]
                  (fn [x] (+ x n))))

(deftest function-literals-and-closures
  (assert (= (add 3 4) 7))
  (assert (= (get-42) 42))
  (assert (= (verbose-add 10 20) 30))
  (assert (= (apply-twice inc 5) 7))
  (def add10 (make-adder 10))
  (assert (= (add10 5) 15)))


(defn test-while []
  (let [i 0]
    (while (< i 5)
      (set! i (+ i 1)))))

(deftest while-loop
  (assert (= (test-while) nil)))


; While with multiple statements
(defn count-down [n]
  (while (> n 0)
    (set! n (- n 1)))
  nil)

(deftest for-and-while-statements
  (assert (= (count-down 3) nil))

  (def values (list))
  (for [x [1 2 3 4 5]]
    (.append values x))
  (assert (= (vec values) [1 2 3 4 5]))

  (def indexes (list))
  (for [i (range 3)]
    (.append indexes i))
  (assert (= (vec indexes) [0 1 2]))

  (def lengths (list))
  (for [item ["apple" "banana" "cherry"]]
    (.append lengths (len item)))
  (assert (= (vec lengths) [5 6 6])))


(defn early-return [x]
  (if (< x 0)
    (return "negative")
    nil)
  (if (> x 100)
    (return "too large")
    nil)
  "just right")


; Return with no value
(defn return-without-value []
  (return))

(deftest return-and-variable-assignment
  (assert (= (early-return -5) "negative"))
  (assert (= (early-return 200) "too large"))
  (assert (= (early-return 50) "just right"))
  (assert (= (return-without-value) nil))


  ; Simple variable mutation
  (def counter 0)
  (set! counter 10)
  (set! counter (+ counter 5))
  (assert (= counter 15))
)


; Mutation in loops
(defn sum-range [n]
  (let [total 0
        i 0]
    (while (< i n)
      (set! total (+ total i))
      (set! i (+ i 1)))
    (return total)))

(deftest case-7

  ; Attribute mutation
  (def obj (SimpleNamespace))
  (set! (. obj x) 100)
  (set! (. obj y) 200)
  (assert (= (sum-range 10) 45))
  (assert (= obj.x 100))
  (assert (= obj.y 200))
)


; For + let + fn
(defn process-list [items]
  (let [results (list)]
    (for [item items]
      (let [result ((fn [x] (* x x)) item)]
        (.append results result)))
    (vec results)))

(deftest for-let-and-function-composition
  (assert (= (process-list [1 2 3 4 5]) [1 4 9 16 25])))


; While + return
(defn find-first [pred lst]
  (let [i 0
        n (len lst)]
    (while (< i n)
      (let [item ((. lst __getitem__) i)]
        (if (pred item)
          (return item)
          nil))
      (set! i (+ i 1)))
    (return nil)))

(def is-even (fn [x] (= (% x 2) 0)))
(deftest case-9

  ; Nested let with fn
  (def result4 (let [x 10]
                 (let [f (fn [y] (+ x y))]
                   (let [z (f 20)]
                     z))))



  ; Empty let
  (def empty-let-result (let [] 42))

  ; Let bindings evaluate in order and preserve side effects
  (def events (list))
  (def let-side-effects
    (let [x (do (.append events :x) 1)
          y (do (.append events :y) 2)]
      (+ x y)))

  (assert (= (find-first is-even [1 3 5 6 7 8]) 6))
  (assert (= result4 30))
  (assert (= empty-let-result 42))
  (assert (= let-side-effects 3))
  (assert (= (vec events) [:x :y]))
)


; Fn returning fn
(def make-multiplier (fn [factor]
                       (fn [x] (* x factor))))

(deftest functions-can-return-functions
  (def times3 (make-multiplier 3))
  (assert (= (times3 7) 21)))


; While with break condition via return
(defn search [target lst]
  (let [i 0]
    (while (< i (len lst))
      (if (= ((. lst __getitem__) i) target)
        (return i)
        nil)
      (set! i (+ i 1)))
    (return -1)))

(deftest loop-can-return-early
  (assert (= (search 30 [10 20 30 40]) 2))
  (assert (= (search 99 [10 20 30 40]) -1)))
