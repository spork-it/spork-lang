; Stage 2 Demo - Macro System + Quasiquote
; This file demonstrates all the Stage 2 features


; ============================================================================
; 1. Quote and Quasiquote
; ============================================================================

(deftest case-1-quote-and-quasiquote

  ; Basic quote - returns data, not evaluated
  (def quoted '(+ 1 2 3))

  ; Quasiquote with unquote
  (def x 10)
  (def y 20)
  (def expr `(+ ~x ~y))

  ; Unquote-splicing
  (def nums [1 2 3])
  (def spliced `(+ ~@nums 4 5))
  (assert (= (str (nth quoted 0)) "+"))
  (assert (= (nth quoted 1) 1))
  (assert (= (nth expr 1) 10))
  (assert (= (nth expr 2) 20))
  (assert (= (vec (drop 1 spliced)) [1 2 3 4 5]))
)


; ============================================================================
; 2. Basic Macros - when, unless
; ============================================================================

(deftest case-2-basic-macros

  ; when - execute body only if test is true
  (def result1 (when (> 5 3)
    42))

  ; unless - execute body only if test is false
  (def result2 (unless (< 5 3)
    99))
  (assert (= result1 42))
  (assert (= result2 99))
)


; ============================================================================
; 3. cond - Multi-way Conditional
; ============================================================================


(def classify (fn [n]
  (cond
    (< n 0) "negative"
    (= n 0) "zero"
    (> n 0) "positive")))



; ============================================================================
; 4. Threading Macros - -> and ->>
; ============================================================================

(deftest case-4-threading-macros

  ; Thread-first (->) - insert value as first argument
  (def result3 (-> 5
    (+ 3)      ; (+ 5 3) => 8
    (* 2)      ; (* 8 2) => 16
    (- 4)))    ; (- 16 4) => 12

  ; Thread-last (->>) - insert value as last argument
  (def result4 (->> 5
    (- 10)     ; (- 10 5) => 5
    (* 2)      ; (* 2 5) => 10
    (+ 3)))    ; (+ 3 10) => 13
  (assert (= result3 12))
  (assert (= result4 13))
)


; ============================================================================
; 5. inc and dec Macros
; ============================================================================

(deftest case-5-inc-dec-macros

  (def counter 0)
  (set! counter (inc counter))
  (set! counter (inc counter))
  (set! counter (inc counter))

  (set! counter (dec counter))
  (assert (= counter 2))
)


; ============================================================================
; 6. Custom User Macros
; ============================================================================


; Define a simple macro to time execution
(defmacro time [expr]
  `(do
     ~expr))

(deftest case-6-custom-user-macros
  (def result5 (time (+ 100 200 300)))
  (assert (= result5 600))
)


; Define a macro for list comprehension-style syntax
(defmacro for-each [var lst & body]
  `(for [~var ~lst]
     ~@body))

(deftest case-6-custom-user-macros-2
  (def squares [])
  (for-each n [1 2 3 4 5]
    (set! squares (conj squares (* n n))))
  (assert (= squares [1 4 9 16 25])))


; ============================================================================
; 7. Multi-arity Operators
; ============================================================================




; ============================================================================
; 8. Macros with Varargs
; ============================================================================


; Define a macro that collects a level and variable number of messages
(defmacro message [level & messages]
  `[~level ~@messages])

(deftest case-8-macros-with-varargs
  (assert (= (message "INFO" "Server" "started" "on" "port" 8080)
             ["INFO" "Server" "started" "on" "port" 8080]))
  (assert (= (message "ERROR" "Connection" "failed")
             ["ERROR" "Connection" "failed"])))


; ============================================================================
; 9. Nested Macros and Hygiene
; ============================================================================

(deftest case-9-nested-macro-expansion

  ; Macros can call other macros
  (def result6 (when (> 10 5)
    (unless (= 10 5)
      (cond
        (= 10 10) "ten"
        true "other"))))

  (assert (= result6 "ten"))
)


; ============================================================================
; Summary
; ============================================================================

(deftest cond-macro-selects-the-first-matching-branch
  (assert (= (classify -5) "negative"))
  (assert (= (classify 0) "zero"))
  (assert (= (classify 10) "positive")))

(deftest operators-support-multiple-arities
  (assert (= (+ 1 2 3 4 5) 15))
  (assert (= (* 2 3 4) 24))
  (assert (= (- 100 10 5) 85))
  (assert (= (/ 100 5 2) 10.0)))
