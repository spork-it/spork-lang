; Test file for throw builtin


; ============================================================================
; 1. Basic throw in try-catch
; ============================================================================


(defn test-throw-basic []
  (try
    (throw (ValueError "Custom error message"))
    (catch ValueError e
      "handled")))



; ============================================================================
; 2. Throw different exception types
; ============================================================================


(defn divide-with-check [x y]
  (if (= y 0)
    (throw (ZeroDivisionError "Cannot divide by zero!"))
    (/ x y)))

(deftest case-2-different-exception-types
  (def result2a
    (try
      (divide-with-check 10 2)
      (catch ZeroDivisionError e
        -1)))


  (def result2b
    (try
      (divide-with-check 10 0)
      (catch ZeroDivisionError e
        -1)))

  (assert (= result2a 5.0))
  (assert (= result2b -1))
)


; ============================================================================
; 3. Throw propagates up
; ============================================================================


(defn inner []
  (throw (RuntimeError "Error from inner")))

(defn middle []
  (inner)
  nil)

(defn outer []
  (try
    (middle)
    (catch RuntimeError e
      "recovered")))



; ============================================================================
; 4. Throw with standard exceptions
; ============================================================================


(defn test-exceptions [type]
  (try
    (cond
      (= type "value") (throw (ValueError "Bad value"))
      (= type "type") (throw (TypeError "Bad type"))
      (= type "key") (throw (KeyError "Bad key"))
      (= type "index") (throw (IndexError "Bad index"))
      true (throw (Exception "Unknown error")))
    (catch ValueError e
      "value-error")
    (catch TypeError e
      "type-error")
    (catch KeyError e
      "key-error")
    (catch IndexError e
      "index-error")
    (catch Exception e
      "general-error")))



; ============================================================================
; 5. Throw in expression context
; ============================================================================

(deftest case-5-throw-as-expression

  (def result5
    (try
      (+ 10 (if true (throw (ValueError "Error in if")) 20))
      (catch ValueError e
        -1)))

  (assert (= result5 -1))
)


; ============================================================================
; 6. Throw with finally
; ============================================================================


(defn test-throw-finally []
  (try
    (throw (RuntimeError "Error!"))
    (catch RuntimeError e
      "caught")
    (finally
      nil)))



; ============================================================================
; 7. Throw without arguments (re-raise) - not supported
; ============================================================================


; throw requires exactly one argument
; (throw) by itself would be a syntax error



; ============================================================================
; 8. Throw in nested contexts
; ============================================================================

(deftest case-8-nested-contexts

  (def result8
    (try
      (for [x [1 2 3]]
        (if (= x 2)
          (throw (RuntimeError "Found 2!"))
          x))
      (catch RuntimeError e
        "stopped-at-2")))

  (assert (= result8 "stopped-at-2"))
)


; ============================================================================
; 9. Throw with custom exception instances
; ============================================================================


(defn validate-age [age]
  (if (< age 0)
    (throw (ValueError (+ "Invalid age: " (str age))))
    (if (> age 150)
      (throw (ValueError (+ "Age too large: " (str age))))
      age)))





; ============================================================================
; Summary
; ============================================================================

(deftest basic-throw-is-caught
  (assert (= (test-throw-basic) "handled")))

(deftest thrown-exception-propagates-through-callers
  (assert (= (outer) "recovered")))

(deftest catch-selects-the-matching-exception-type
  (assert (= (test-exceptions "value") "value-error"))
  (assert (= (test-exceptions "type") "type-error"))
  (assert (= (test-exceptions "key") "key-error"))
  (assert (= (test-exceptions "index") "index-error"))
  (assert (= (test-exceptions "other") "general-error")))

(deftest finally-runs-after-throw
  (assert (= (test-throw-finally) "caught")))

(deftest custom-exception-message-includes-data
  (def message
    (try
      (validate-age -1)
      (catch ValueError error (str error))))
  (assert (= message "Invalid age: -1"))
  (assert (= (validate-age 42) 42)))
