; Test file for try-catch-finally syntax


; ============================================================================
; 1. Basic try-catch
; ============================================================================


(defn test-basic-try []
  (try
    (/ 10 2)
    (catch Exception e
      -1)))


(defn test-divide-by-zero []
  (try
    (/ 10 0)
    (catch ZeroDivisionError e
      -1)))



; ============================================================================
; 2. Multiple catch clauses
; ============================================================================


(defn test-error [x]
  (try
    (if (= x 0)
      (/ 1 0)
      (if (= x 1)
        (. [1 2] 10)
        (+ x 100)))
    (catch ZeroDivisionError e
      "div-error")
    (catch IndexError e
      "index-error")
    (catch Exception e
      "other-error")))



; ============================================================================
; 3. Try-finally (no catch)
; ============================================================================


(defn with-cleanup [events]
  (try
    42
    (finally
      (events.append :cleanup))))

(deftest case-3-try-finally
  (def events (list))
  (def result (with-cleanup events))
  (assert (= result 42))
  (assert (= events (list [:cleanup]))))


; ============================================================================
; 4. Try-catch-finally
; ============================================================================


(defn full-try [should-error]
  (try
    (if should-error
      (/ 1 0)
      "success")
    (catch ZeroDivisionError e
      "caught")
    (finally
      nil)))

(deftest case-4-try-catch-finally
  (def result4a (full-try false))

  (def result4b (full-try true))
  (assert (= result4a "success"))
  (assert (= result4b "caught"))
)


; ============================================================================
; 5. Nested try blocks
; ============================================================================


(defn nested-try []
  (try
    (try
      (/ 1 0)
      (catch ValueError e
        "inner"))
    (catch ZeroDivisionError e
      "outer")))



; ============================================================================
; 6. Try in let body
; ============================================================================

(deftest case-6-try-in-let-body

  (def result6
    (let [x 10]
      (try
        (/ x 2)
        (catch Exception e
          0))))

  (assert (= result6 5.0))
)


; ============================================================================
; 7. Re-raising and propagation
; ============================================================================


(defn inner-func []
  (/ 1 0))

(defn outer-func []
  (try
    (inner-func)
    (catch ZeroDivisionError e
      "recovered")))



; ============================================================================
; 8. Try with multiple body forms
; ============================================================================


(defn multi-statement-try []
  (try
    "final-value"
    (catch Exception e
      "error")))



; ============================================================================
; 9. Finally executes even without catch
; ============================================================================


(defn finally-no-catch []
  (let [result nil]
    (try
      (set! result 100)
      (finally
        nil))
    result))



; ============================================================================
; 10. Try-catch with variable binding
; ============================================================================


(defn test-exception-var []
  (try
    (/ 1 0)
    (catch ZeroDivisionError e
      "handled")))



; ============================================================================
; 11. Statement context in do block
; ============================================================================

(deftest case-11-try-in-do-block

  (def result
    (do
      (try
        (catch Exception e
          nil))
      nil))
  (assert (= result nil))
)


; ============================================================================
; Summary
; ============================================================================

(deftest basic-try-catch
  (assert (= (test-basic-try) 5.0))
  (assert (= (test-divide-by-zero) -1)))

(deftest multiple-catch-clauses
  (assert (= (test-error 0) "div-error"))
  (assert (= (test-error 1) "index-error"))
  (assert (= (test-error 5) 105)))

(deftest nested-try-propagates-to-matching-handler
  (assert (= (nested-try) "outer")))

(deftest exception-propagates-to-calling-handler
  (assert (= (outer-func) "recovered")))

(deftest try-supports-multiple-body-forms
  (assert (= (multi-statement-try) "final-value")))

(deftest finally-runs-without-a-catch-clause
  (assert (= (finally-no-catch) 100)))

(deftest catch-binds-the-exception
  (assert (= (test-exception-var) "handled")))
