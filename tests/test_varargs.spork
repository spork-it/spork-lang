; Test varargs support in fn and defn


; Test defn with varargs
(defn sum [& nums]
  (let [total 0]
    (for [n nums]
      (set! total (+ total n)))
    total))


; Test defn with regular args and varargs
(defn greet [greeting & names]
  (if (= (len names) 0)
    (+ greeting " everyone!")
    (let [all-names (call " and " join names)]
      (+ greeting " " all-names "!"))))


; Test fn with varargs
(deftest test-fn-with-varargs
  (let [add-all (fn [& nums]
                  (if (= (len nums) 0)
                    0
                    (+ (. nums 0) (if (> (len nums) 1) (. nums 1) 0) (if (> (len nums) 2) (. nums 2) 0))))]
    (assert (= (add-all) 0))
    (assert (= (add-all 2) 2))
    (assert (= (add-all 2 3) 5))
    (assert (= (add-all 2 3 4) 9)))
)


; Test fn with regular args and varargs
(deftest test-fn-with-regular-args-and-varargs
  (let [format-list (fn [prefix & items]
                      (if (= (len items) 0)
                        (+ prefix ": (empty)")
                        (+ prefix ": " (str items))))]
    (assert (= (format-list "Items") "Items: (empty)"))
    (assert (= (format-list "Items" "a") "Items: ('a',)"))
    (assert (= (format-list "Items" "a" "b" "c") "Items: ('a', 'b', 'c')")))
)


; Test fn with varargs passed directly
(deftest test-fn-with-varargs-passed-directly
  (let [join-strings (fn [& strs] (call "" join strs))]
    (assert (= (join-strings "a" "b") "ab"))
    (assert (= (join-strings "hello" "world") "helloworld")))
)


; Test nested functions with varargs
(defn make-adder [base]
  (fn [& nums]
    (+ base (if (> (len nums) 0) (. nums 0) 0) (if (> (len nums) 1) (. nums 1) 0))))

(deftest test-nested-functions-with-varargs
  (let [add10 (make-adder 10)
        add100 (make-adder 100)]
    (assert (= (add10 1 2) 13))
    (assert (= (add100 5 10) 115)))
)


; Test varargs with apply-like behavior
(defn max-of [& nums]
  (if (= (len nums) 0)
    nil
    (max nums)))


; Test varargs collecting into list
(deftest test-varargs-collecting-into-list
  (let [make-list (fn [& items] items)]
    (assert (= (vec (make-list 1 2 3)) [1 2 3]))
    (assert (= (vec (make-list "a" "b" "c")) ["a" "b" "c"])))
)


; Test method call syntax with varargs
(deftest test-method-call-syntax-with-varargs
  (let [words ["hello" "world" "from" "spork"]]
    (assert (= (call " " join words) "hello world from spork")))

  (let [numbers (list [1 2 3 4 5])]
    (assert (= (call numbers count 3) 1)))
)

(deftest named-function-varargs
  (assert (= (sum) 0))
  (assert (= (sum 1 2 3 4) 10))
  (assert (= (greet "Hello") "Hello everyone!"))
  (assert (= (greet "Hello" "Alice" "Bob") "Hello Alice and Bob!")))

(deftest varargs-can-be-forwarded-to-builtins
  (assert (= (max-of) nil))
  (assert (= (max-of 3 9 4) 9)))
